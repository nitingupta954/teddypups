# Postgres connection string (Neon). Without it, enquiries are only logged in development.
DATABASE_URL=
# Password for /admin (HTTP Basic auth, user "admin" unless ADMIN_USER is set). Unset = admin disabled.
ADMIN_PASSWORD=
ADMIN_USER=
# Canonical URL used in metadata, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000
